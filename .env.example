# =============================================================================
#  Aloud - environment configuration
#  Copy to `.env` and fill in what you need. Every value below has a working
#  default, so the app runs with an empty .env file.
# =============================================================================

# --- Server -----------------------------------------------------------------
ALOUD_HOST=127.0.0.1
ALOUD_PORT=8000
# Used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated at boot (sessions drop on restart).
ALOUD_SECRET_KEY=

# --- Storage ----------------------------------------------------------------
# SQLite by default. Point at any directory you like.
ALOUD_DATA_DIR=./data
ALOUD_DATABASE_URL=sqlite:///./data/aloud.db
ALOUD_MAX_UPLOAD_MB=25
# Recordings get their own, larger cap: an hour of lecture video is
# routinely a few hundred megabytes.
ALOUD_MAX_MEDIA_MB=300

# --- AI teacher -------------------------------------------------------------
# "auto"      - use Claude if ANTHROPIC_API_KEY is set, else the on-device engine
# "ondevice"  - always use the built-in on-device teaching engine (no network)
# "anthropic" - require Claude; fail loudly if the key is missing
ALOUD_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ALOUD_ANTHROPIC_MODEL=claude-sonnet-5

# --- Speech -----------------------------------------------------------------
# Downloadable audio files. "gtts" needs network, "pyttsx3" is offline (Windows),
# "none" disables downloads and the UI says so honestly.
ALOUD_TTS_PROVIDER=auto
# Speech recognition. Used for two things: answers from browsers that cannot
# listen, and transcribing uploaded video and audio so recordings can be
# taught. "whisper" loads a local model on first use (~75MB for "base"),
# "none" disables both and the interface says so.
ALOUD_STT_PROVIDER=auto
ALOUD_WHISPER_MODEL=base

# --- Development ------------------------------------------------------------
ALOUD_DEBUG=false
